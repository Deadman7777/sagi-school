# ════════════════════════════════════════════════════════════════════
#  SAGI SCHOOL — Variables d'environnement (mode cloud)
# ════════════════════════════════════════════════════════════════════
# Copier vers .env sur le serveur et remplir.
# Ne jamais commiter .env (déjà dans .gitignore normalement).
#
# Sur le serveur, lancer Django avec :
#   DJANGO_SETTINGS_MODULE=config.settings.cloud
# ════════════════════════════════════════════════════════════════════

# ─── Django ────────────────────────────────────────────────────────
# Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=api.sagi-school.com

# ─── Base de données PostgreSQL ────────────────────────────────────
DB_NAME=sagi_school_cloud
DB_USER=sagi_cloud
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ─── CORS / CSRF (front cloud) ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://app.sagi-school.com
CSRF_TRUSTED_ORIGINS=https://app.sagi-school.com,https://api.sagi-school.com

# ─── HTTPS / sécurité ──────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ─── Logs ──────────────────────────────────────────────────────────
LOG_DIR=/var/log/sagi-school
LOG_LEVEL=INFO

# ─── Email (mot de passe oublié, etc. — optionnel pour démarrer) ───
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@sagi-school.com
