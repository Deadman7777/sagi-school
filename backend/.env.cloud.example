# ════════════════════════════════════════════════════════════════════
#  SAGI SCHOOL — Variables d'environnement (mode cloud)
# ════════════════════════════════════════════════════════════════════
# Copier vers .env sur le serveur et remplir.
# Ne jamais commiter .env (déjà dans .gitignore normalement).
#
# Sur le serveur, lancer Django avec :
#   DJANGO_SETTINGS_MODULE=config.settings.cloud
# ════════════════════════════════════════════════════════════════════

# ─── Django ────────────────────────────────────────────────────────
# Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=api.sagi-school.com

# ─── Base de données PostgreSQL ────────────────────────────────────
DB_NAME=sagi_school_cloud
DB_USER=sagi_cloud
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ─── CORS / CSRF ───────────────────────────────────────────────────
# Le site vitrine DOIT y figurer : il appelle /api/public/ (demande de
# démo, compteurs) et /api/assistant/ (SAMA). Sans lui, le navigateur
# bloque ces appels avant qu'ils n'atteignent le serveur — et rien
# n'apparaît dans les journaux Django.
CORS_ALLOWED_ORIGINS=https://app.sagi-school.com,https://sagi-school.com,https://www.sagi-school.com
CSRF_TRUSTED_ORIGINS=https://app.sagi-school.com,https://api.sagi-school.com

# ─── HTTPS / sécurité ──────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ─── Logs ──────────────────────────────────────────────────────────
LOG_DIR=/var/log/sagi-school
LOG_LEVEL=INFO

# ─── Email (mot de passe oublié, etc. — optionnel pour démarrer) ───
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@sagi-school.com

# ─── Assistant SAMA (site vitrine) ─────────────────────────────────
# Sans clé, l'assistant se désactive proprement : /api/assistant/etat/
# répond « indisponible » et le site n'affiche aucun bouton.
ANTHROPIC_API_KEY=

# Bornes de dépense — un site public n'a pas de payeur en face de chaque
# conversation. Valeurs par défaut du code, à ajuster ici si besoin.
SAMA_PLAFOND_MOIS_FCFA=10000
SAMA_PLAFOND_JOUR_FCFA=1000
SAMA_MAX_CONVERSATIONS_VISITEUR_JOUR=5
SAMA_MAX_MESSAGES_CONVERSATION=20
SAMA_TAUX_USD_FCFA=610

# ─── Commercial (catalogue et devis) ───────────────────────────────
# Remise sur le paiement annuel. Pratiquée par l'écran Licences, mais
# absente des documents officiels : mettre 0 pour s'en tenir aux tarifs
# publiés. Voir backend/apps/licences/catalogue.py.
REMISE_ANNUELLE=0.10
# HG-DEV-2026-0001 a été établi à la main : la séquence démarre au-dessus.
DEVIS_NUMERO_MIN=2
EDITEUR_TELEPHONE=+221 70 328 61 51 · +221 78 429 78 30
EDITEUR_SITE=sagi-school.com
EDITEUR_NINEA=012673986
