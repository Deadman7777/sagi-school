; ════════════════════════════════════════════════════════════════════
;  SAGI SCHOOL — systemd unit pour gunicorn (cloud)
;
;  Installation :
;    sudo cp gunicorn.service /etc/systemd/system/sagi-school.service
;    sudo systemctl daemon-reload
;    sudo systemctl enable --now sagi-school
;
;  Commandes :
;    sudo systemctl status sagi-school
;    sudo systemctl restart sagi-school
;    sudo journalctl -u sagi-school -f
; ════════════════════════════════════════════════════════════════════
[Unit]
Description=SAGI SCHOOL API (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=sagi
Group=sagi
WorkingDirectory=/opt/sagi-school/backend
EnvironmentFile=/opt/sagi-school/backend/.env
Environment="DJANGO_SETTINGS_MODULE=config.settings.cloud"
Environment="PYTHONUNBUFFERED=1"

; Processus : 2 x coeurs + 1 (CPX32 = 4 coeurs). Le goulot est le GIL, pas
; la base : un ecran lourd tient son processus 1 a 2 s, et a 3 processus
; trois utilisateurs simultanes suffisaient a faire attendre tous les autres.
; 2 fils par processus couvrent l'attente sur PostgreSQL. max-requests recycle
; les processus pour borner la memoire. La derniere colonne du journal
; d'acces est la duree de la requete en ms : voir DEPLOY.md, « Lenteurs ».
ExecStart=/opt/sagi-school/backend/venv/bin/gunicorn \
    --workers 9 \
    --worker-class gthread \
    --threads 2 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --bind unix:/run/sagi-school/gunicorn.sock \
    --access-logfile /var/log/sagi-school/access.log \
    --access-logformat '%%(h)s %%(t)s "%%(r)s" %%(s)s %%(b)s %%(M)s' \
    --error-logfile  /var/log/sagi-school/error.log \
    --timeout 120 \
    config.wsgi:application

Restart=on-failure
RestartSec=5
RuntimeDirectory=sagi-school
RuntimeDirectoryMode=0755

; Sécurité
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
